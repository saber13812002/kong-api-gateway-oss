# ============================================================================
# Kong OSS API Gateway — environment template
#
# Copy to .env and generate a strong password:
#   cp .env.example .env
#   openssl rand -hex 24   # -> paste as KONG_PG_PASSWORD
#
# .env is git-ignored. NEVER commit real credentials.
# ============================================================================

# Compose project name: namespaces ALL containers/volumes/networks.
# Change this if you need to run multiple stacks side by side.
COMPOSE_PROJECT_NAME=kong-gw-oss

# Pinned image versions (reproducible builds).
KONG_VERSION=3.9.4
POSTGRES_VERSION=16.6-alpine

# REQUIRED — strong random password for the internal PostgreSQL.
# Only used inside the private Docker network (no host port on Postgres).
KONG_PG_PASSWORD=change-me-strong-random-password

# Host port bindings (loopback by default = not reachable from the network).
# The Admin API should STAY loopback (see docs/SECURITY.md).
KONG_PROXY_HOST=127.0.0.1
KONG_PROXY_PORT=18080
KONG_ADMIN_HOST=127.0.0.1
KONG_ADMIN_PORT=18001

# Name the echo backend reports about itself (cosmetic, used in tests).
ECHO_BACKEND_NAME=oss-echo
